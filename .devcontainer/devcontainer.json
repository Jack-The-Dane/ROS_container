{
  "name": "ROS 2 Jazzy Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": [
    "--net=host",                             // Networking for ROS
    "--ipc=host",                             // Shared memory for RViz/Gazebo
    "--env=DISPLAY=${localEnv:DISPLAY}",      // Forward GUI
    "--env=QT_X11_NO_MITSHM=1",
    "--privileged"                            // Required for some Gazebo/Sim hardware access
  ],
  "containerEnv": {
    "ROS_LOCALHOST_ONLY": "1",
    "DISPLAY": "unix:0"
  },
  "mounts": [
    {
    "source": "/tmp/.X11-unix",
    "target": "/tmp/.X11-unix",
    "type": "bind",
    //"consistency": "cached"
    },
    {
    "source": "/dev/dri",
    "target": "/dev/dri",
    "type": "bind",
    //"consistency": "cached"
    },
    {
    "source": "/dev/shm",
    "target": "/dev/shm",
    "type": "bind",
    //"consistency": "cached"
    },
    {
        "source": "/dev",
        "target": "/dev",
        "type": "bind",
        //"consistency": "cached"
    }
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces",
  "remoteUser": "ubuntu",
  "customizations": {
    "vscode": {
      "extensions": [
        "twxs.cmake",
        "ms-vscode.cpptools",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "Ranch-Hand-Robotics.rde-ros-2",
        "mechatroner.rainbow-csv"
      ]
    }
  },
    "postCreateCommand": {
    "video-group": "sudo usermod -aG video ubuntu",
    "update": "sudo apt update && sudo apt dist-upgrade -y && rosdep update",
    "install-gnss": "cd /opt/ros/jazzy/lib/mavros && sudo ./install_geographiclib_datasets.sh"
  },
}
